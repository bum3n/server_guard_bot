# Токен бота Telegram (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID вашего аккаунта Telegram для отправки алертов и администрирования
ADMIN_CHAT_ID=123456789

# Дополнительные ID администраторов через запятую (опционально)
ADMIN_CHAT_IDS=123456789,987654321

# IP-адрес сервера и рабочий домен
SERVER_IP=1.2.3.4
DOMAIN=example.com

# Настройки интеграции с 3X-UI OpenAPI
# Bearer API токен из настроек панели 3X-UI
XUI_API_TOKEN=your_3xui_bearer_token_here
# Базовый URL панели 3X-UI (локальный или внешний)
XUI_BASE_URL=https://127.0.0.1:44506/3x-ui-panel
# Путь подписки (Root path подписок из настроек 3X-UI)
XUI_SUB_PATH=sub
