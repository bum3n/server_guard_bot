# ==============================================================================
# Server Guard — Конфигурация окружения (.env)
# Скопируйте этот файл в .env и укажите ваши реальные значения
# ==============================================================================

# Токен Telegram-бота (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Числовой ID вашего аккаунта Telegram (узнайте через @userinfobot)
ADMIN_CHAT_ID=123456789

# Дополнительные ID администраторов через запятую (опционально)
ADMIN_CHAT_IDS=123456789,987654321

# Сетевой IP-адрес сервера и рабочий домен
SERVER_IP=1.2.3.4
DOMAIN=localhost

# Название сервера в шапке бота (по умолчанию: Основной сервер)
SERVER_NAME=Основной сервер

# Пороги алертов при высокой нагрузке (в процентах)
CPU_THRESHOLD=85.0
RAM_THRESHOLD=90.0
DISK_THRESHOLD=90.0
